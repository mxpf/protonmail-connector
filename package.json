{
  "name": "protonmail-connector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "start": "node dist/src/server.js",
    "setup": "bash scripts/login-hosted-bridge.sh",
    "check:hosted": "node scripts/check-hosted-mcp.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "imapflow": "2.0.5",
    "mailparser": "3.9.28",
    "nodemailer": "^10.0.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4",
    "typescript": "^6"
  }
}
